# ── Supabase ──────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Project URL  (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# service_role secret key  ← keep this server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ────────────────────────────────────────────────────
PORT=3000
